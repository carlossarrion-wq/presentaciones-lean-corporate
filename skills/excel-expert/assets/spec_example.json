      "rows": [
        ["2026-01-01", 12500, "=B{r}*Supuestos!$B$2", "=B{r}+C{r}", "=B{r}/Supuestos!$B$3", "Online"],
        ["2026-02-01", 14100, "=B{r}*Supuestos!$B$2", "=B{r}+C{r}", "=B{r}/Supuestos!$B$3", "Tienda"],
        ["2026-03-01", 16850, "=B{r}*Supuestos!$B$2", "=B{r}+C{r}", "=B{r}/Supuestos!$B$3", "Online"],
        ["2026-04-01", 15300, "=B{r}*Supuestos!$B$2", "=B{r}+C{r}", "=B{r}/Supuestos!$B$3", "Mayorista"],
        ["2026-05-01", 17920, "=B{r}*Supuestos!$B$2", "=B{r}+C{r}", "=B{r}/Supuestos!$B$3", "Online"],
